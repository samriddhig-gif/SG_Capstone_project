# Extract the course dataset separately; do not commit the dataset itself.
ZENTROMART_DATA_DIR=../Capstone_Project_Dataset_FTTT_2026

# Tested LLM configuration (Groq, OpenAI-compatible Chat Completions).
# Create your own key and enter it locally in .env. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45

# Gnani STT/TTS. Enter your own key locally in .env.
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5

RETRIEVAL_TOP_K=6
ENABLE_SEMANTIC_EMBEDDINGS=true
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
VOICEOPS_DEBUG=false
